FROM ghcr.io/imputnet/cobalt:11

# Cobalt requires API_PORT >= 1024. Vercel's container router is pointed at
# the same port through the project-level PORT environment variable.
ENV API_PORT=9000
ENV API_LISTEN_ADDRESS=0.0.0.0
ENV API_AUTH_REQUIRED=1
ENV API_KEY_URL=file:///app/keys.json
ENV CORS_WILDCARD=0

COPY --chown=node:node start.sh /app/start.sh
ENTRYPOINT ["sh", "/app/start.sh"]
CMD ["node", "src/cobalt"]

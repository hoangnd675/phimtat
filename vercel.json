{
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "cobalt",
          "format": "url",
          "env": "COBALT_INTERNAL_URL"
        }
      ]
    },
    "cobalt": {
      "root": "extractor",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
